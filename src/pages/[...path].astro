---
/**
 * Every page on the site is generated here from the tool registry and the
 * static page list, so each language can have its own URL slug.
 */
import Base from '../layouts/Base.astro';
import ToolIsland from '../components/ToolIsland.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { LOCALES, localePath, type Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { TOOLS, toolsFor, type ToolEntry } from '../tools/registry';
import { PAGES, type StaticPageId } from '../pages-content/pages';
import { SITE } from '../site';

type PageProps =
  | { kind: 'home'; locale: Locale }
  | { kind: 'tool'; locale: Locale; tool: ToolEntry }
  | { kind: 'page'; locale: Locale; page: StaticPageId };

export function getStaticPaths() {
  // getStaticPaths runs in isolation, so helpers must live inside it.
  const strip = (p: string) => p.replace(/^\/|\/$/g, '') || undefined;
  const paths: { params: { path: string | undefined }; props: PageProps }[] = [];
  for (const locale of LOCALES) {
    paths.push({ params: { path: strip(localePath(locale)) }, props: { kind: 'home', locale } });
    for (const tool of TOOLS) {
      const c = tool.content[locale];
      if (c) paths.push({ params: { path: strip(localePath(locale, c.slug)) }, props: { kind: 'tool', locale, tool } });
    }
    for (const page of Object.keys(PAGES) as StaticPageId[]) {
      paths.push({
        params: { path: strip(localePath(locale, PAGES[page][locale].slug)) },
        props: { kind: 'page', locale, page },
      });
    }
  }
  return paths;
}

const props = Astro.props as PageProps;
const { locale } = props;
const t = UI[locale];
const abs = (p: string) => new URL(p, SITE.url).href;

const alternatesFor = (make: (l: Locale) => string | undefined) =>
  Object.fromEntries(LOCALES.map((l) => [l, make(l)]).filter(([, p]) => p)) as Partial<Record<Locale, string>>;

let title = '';
let description = '';
let alternates: Partial<Record<Locale, string>> = {};
let jsonLd: object[] = [];

if (props.kind === 'home') {
  title = `${t.homeTitle} · ${SITE.name}`;
  description = t.homeIntro;
  alternates = alternatesFor((l) => localePath(l));
  jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: abs(localePath(locale)), inLanguage: locale }];
}

const tool = props.kind === 'tool' ? props.tool : null;
const c = tool ? tool.content[locale]! : null;
if (tool && c) {
  title = c.metaTitle;
  description = c.metaDescription;
  alternates = alternatesFor((l) => (tool.content[l] ? localePath(l, tool.content[l]!.slug) : undefined));
  const url = abs(localePath(locale, c.slug));
  jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: c.h1,
      url,
      description: c.metaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      inLanguage: locale,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.home, item: abs(localePath(locale)) },
        { '@type': 'ListItem', position: 2, name: c.h1, item: url },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ];
}

const page = props.kind === 'page' ? PAGES[props.page][locale] : null;
if (props.kind === 'page' && page) {
  title = `${page.title} · ${SITE.name}`;
  description = page.description;
  alternates = alternatesFor((l) => localePath(l, PAGES[props.page][l].slug));
}

const related = tool ? toolsFor(locale).filter((x) => x.tool.id !== tool.id).slice(0, 3) : [];
const dateFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base locale={locale} title={title} description={description} alternates={alternates} jsonLd={jsonLd}>
  {props.kind === 'home' && (
    <>
      <section class="hero">
        <p class="eyebrow">/ {t.tagline}</p>
        <h1>{t.homeTitle}</h1>
        <p>{t.homeIntro}</p>
      </section>
      <div class="tool-grid">
        {toolsFor(locale).map(({ tool: x, content: xc }) => (
          <a class="tool-tile" href={localePath(locale, xc.slug)}>
            <ToolIcon name={x.icon} />
            <strong>{xc.h1}</strong>
            <span>{xc.metaDescription.split('. ')[0]}.</span>
          </a>
        ))}
      </div>
    </>
  )}

  {tool && c && (
    <>
      <section class="hero">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={localePath(locale)}>{t.home}</a> / <span>{c.h1}</span>
        </nav>
        <p class="eyebrow">/ {c.eyebrow}</p>
        <h1>{c.h1}</h1>
        <p>{c.intro}</p>
      </section>

      <div class="tool-card">
        <ToolIsland id={tool.id} labels={c.labels} locale={locale} />
      </div>
      <p class="privacy-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="5" y="11" width="14" height="10" rx="2"></rect>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
        {t.privacyNote}
      </p>

      <article class="content">
        {c.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
        <section class="faq">
          <h2>{t.faq}</h2>
          {c.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
        <p class="updated">
          {t.updated}: <time datetime={c.updated}>{dateFmt.format(new Date(c.updated))}</time>
        </p>
      </article>

      {related.length > 0 && (
        <section class="content">
          <h2>{t.related}</h2>
          <div class="tool-grid">
            {related.map(({ tool: x, content: xc }) => (
              <a class="tool-tile" href={localePath(locale, xc.slug)}>
                <ToolIcon name={x.icon} />
                <strong>{xc.h1}</strong>
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  {page && (
    <>
      <section class="hero">
        <h1>{page.title}</h1>
      </section>
      <article class="content" set:html={page.html} />
    </>
  )}
</Base>
