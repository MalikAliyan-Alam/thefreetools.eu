---
/**
 * Every page on the site is generated here from the tool registry and the
 * static page list, so each language can have its own URL slug.
 */
import Base from '../layouts/Base.astro';
import ToolIsland from '../components/ToolIsland.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { localePath } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { TOOLS, toolsFor } from '../tools/registry';
import { GUIDES, guidePath, guidesHubPath, guidesForTool } from '../guides/registry';
import { teaser } from '../tools/teasers';
import { PAGES } from '../pages-content/pages';
import { SITE } from '../site';
import { allRoutes, type RouteEntry } from '../lib/routes';

type PageProps = RouteEntry;

export function getStaticPaths() {
  return allRoutes().map((r) => ({ params: { path: r.path.replace(/^\/|\/$/g, '') || undefined }, props: r }));
}

const props = Astro.props as PageProps;
const { locale } = props;
const t = UI[locale];
const abs = (p: string) => new URL(p, SITE.url).href;

let title = '';
let description = '';
const alternates = props.alternates;
let jsonLd: object[] = [];

const ORG_ID = `${SITE.url}/#org`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/logo.svg`,
  email: SITE.email,
  founder: { '@type': 'Person', name: SITE.author.name, sameAs: [SITE.author.url] },
};

if (props.kind === 'home') {
  title = `${t.homeTitle} · ${SITE.name}`;
  description = t.homeIntro;
  jsonLd = [
    organization,
    { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: abs(localePath(locale)), inLanguage: locale, publisher: { '@id': ORG_ID } },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: toolsFor(locale).map(({ content: xc }, i) => ({ '@type': 'ListItem', position: i + 1, name: xc.h1, url: abs(localePath(locale, xc.slug)) })),
    },
  ];
}

const tool = props.kind === 'tool' ? props.tool : null;
const c = tool ? tool.content[locale]! : null;
if (tool && c) {
  title = c.metaTitle;
  description = c.metaDescription;
  const url = abs(localePath(locale, c.slug));
  jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: c.h1,
      url,
      description: c.metaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: locale,
      isAccessibleForFree: true,
      dateModified: c.updated,
      publisher: { '@id': ORG_ID },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    organization,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.home, item: abs(localePath(locale)) },
        { '@type': 'ListItem', position: 2, name: c.h1, item: url },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ];
}

const page = props.kind === 'page' ? PAGES[props.page][locale] : null;
if (props.kind === 'page' && page) {
  title = `${page.title} · ${SITE.name}`;
  description = page.description;
}

const guidesHub = props.kind === 'guides';
if (guidesHub) {
  title = `${t.guidesTitle} · ${SITE.name}`;
  description = t.guidesIntro;
  jsonLd = [
    organization,
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: GUIDES[locale].map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.h1, url: abs(guidePath(locale, g)) })),
    },
  ];
}

const guide = props.kind === 'guide' ? props.guide : null;
const guideTool = guide ? TOOLS.find((x) => x.id === guide.tool)?.content[locale] : undefined;
if (guide) {
  title = guide.metaTitle;
  description = guide.metaDescription;
  const url = abs(guidePath(locale, guide));
  jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: guide.h1,
      description: guide.metaDescription,
      url,
      inLanguage: locale,
      datePublished: guide.published,
      dateModified: guide.updated,
      author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      publisher: { '@id': ORG_ID },
      mainEntityOfPage: url,
    },
    organization,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.home, item: abs(localePath(locale)) },
        { '@type': 'ListItem', position: 2, name: t.guides, item: abs(guidesHubPath(locale)) },
        { '@type': 'ListItem', position: 3, name: guide.h1, item: url },
      ],
    },
  ];
}
const moreGuides = guide ? GUIDES[locale].filter((g) => g !== guide).slice(0, 4) : [];
const toolGuides = tool ? guidesForTool(locale, tool.id) : [];

const related = tool ? toolsFor(locale).filter((x) => x.tool.id !== tool.id).slice(0, 3) : [];
const dateFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base locale={locale} title={title} description={description} alternates={alternates} jsonLd={jsonLd}>
  {props.kind === 'home' && (
    <>
      <section class="hero">
        <p class="eyebrow">/ {t.tagline}</p>
        <h1>{t.homeTitle}</h1>
        <p>{t.homeIntro}</p>
      </section>
      <div class="tool-grid">
        {toolsFor(locale).map(({ tool: x, content: xc }) => (
          <a class="tool-tile" href={localePath(locale, xc.slug)}>
            <span class="tile-top"><ToolIcon name={x.icon} /><em>{xc.eyebrow}</em></span>
            <strong>{xc.h1}</strong>
            <span>{xc.metaDescription.split('. ')[0]}.</span>
            <code class="tile-demo" dir={locale === 'ar' ? 'rtl' : 'ltr'}>{teaser(x.id, locale)}</code>
          </a>
        ))}
      </div>
    </>
  )}

  {tool && c && (
    <>
      <section class="hero">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={localePath(locale)}>{t.home}</a> / <span>{c.h1}</span>
        </nav>
        <p class="eyebrow">/ {c.eyebrow}</p>
        <h1>{c.h1}</h1>
        <p>{c.intro}</p>
      </section>

      <div class="tool-card">
        <ToolIsland id={tool.id} labels={c.labels} locale={locale} />
      </div>
      <p class="privacy-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="5" y="11" width="14" height="10" rx="2"></rect>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
        {t.privacyNote}
      </p>

      <article class="content">
        {c.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
        <section class="faq">
          <h2>{t.faq}</h2>
          {c.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
        <p class="updated">
          {t.updated}: <time datetime={c.updated}>{dateFmt.format(new Date(c.updated))}</time>
        </p>
      </article>

      {toolGuides.length > 0 && (
        <section class="content">
          <h2>{t.guidesFor}</h2>
          <ul class="guide-list">
            {toolGuides.map((g) => (
              <li>
                <a href={guidePath(locale, g)}>
                  <strong>{g.h1}</strong>
                  <span>{g.answer}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section class="content">
          <h2>{t.related}</h2>
          <div class="tool-grid">
            {related.map(({ tool: x, content: xc }) => (
              <a class="tool-tile" href={localePath(locale, xc.slug)}>
                <ToolIcon name={x.icon} />
                <strong>{xc.h1}</strong>
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  {guidesHub && (
    <>
      <section class="hero">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={localePath(locale)}>{t.home}</a> / <span>{t.guides}</span>
        </nav>
        <h1>{t.guidesTitle}</h1>
        <p>{t.guidesIntro}</p>
      </section>
      <ul class="guide-list">
        {GUIDES[locale].map((g) => (
          <li>
            <a href={guidePath(locale, g)}>
              <strong>{g.h1}</strong>
              <span>{g.metaDescription}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  {guide && (
    <>
      <section class="hero guide-hero">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={localePath(locale)}>{t.home}</a> / <a href={guidesHubPath(locale)}>{t.guides}</a> / <span>{guide.h1}</span>
        </nav>
        <h1>{guide.h1}</h1>
        <p class="guide-meta">
          {t.published}: <time datetime={guide.published}>{dateFmt.format(new Date(guide.published))}</time>
          {guide.updated !== guide.published && (
            <> · {t.updated}: <time datetime={guide.updated}>{dateFmt.format(new Date(guide.updated))}</time></>
          )}
        </p>
      </section>
      <article class="content guide">
        <div class="answer">
          <p class="answer-label">{t.shortAnswer}</p>
          <p>{guide.answer}</p>
        </div>
        {guideTool && (
          <a class="cta-card" href={localePath(locale, guideTool.slug)}>
            <span>
              <strong>{guideTool.h1}</strong>
              <span>{t.useTool} →</span>
            </span>
          </a>
        )}
        {guide.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
        {guide.faq && guide.faq.length > 0 && (
          <section class="faq">
            <h2>{t.faq}</h2>
            {guide.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}
      </article>
      {moreGuides.length > 0 && (
        <section class="content">
          <h2>{t.guides}</h2>
          <ul class="guide-list">
            {moreGuides.map((g) => (
              <li>
                <a href={guidePath(locale, g)}>
                  <strong>{g.h1}</strong>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )}

  {page && (
    <>
      <section class="hero">
        <h1>{page.title}</h1>
      </section>
      <article class="content" set:html={page.html} />
    </>
  )}
</Base>
