---
/**
 * Brand mark: a gear split ink/terracotta with a wrench behind it and an "ft"
 * monogram inside (the letters share one crossbar). Colors come from the
 * --logo-* tokens so it follows dark mode. Standalone copy: public/logo.svg.
 */
---
<svg viewBox="-2 -2 68 68" aria-hidden="true" class="logo-mark">
  <defs>
    <clipPath id="logo-l"><rect x="-2" y="-2" width="34" height="68"></rect></clipPath>
    <clipPath id="logo-r"><rect x="32" y="-2" width="34" height="68"></rect></clipPath>
    <mask id="logo-jaws">
      <rect x="-10" y="-10" width="84" height="84" fill="#fff"></rect>
      <rect x="61" y="29.4" width="12" height="5.2" fill="#000"></rect>
      <rect x="-9" y="29.4" width="12" height="5.2" fill="#000"></rect>
    </mask>
    <g id="logo-gear">
      <circle cx="32" cy="32" r="20" fill="none" stroke-width="6.5"></circle>
      <rect x="28.5" y="5" width="7" height="8" rx="1"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(45 32 32)"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(90 32 32)"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(135 32 32)"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(180 32 32)"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(225 32 32)"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(270 32 32)"></rect>
      <rect x="28.5" y="5" width="7" height="8" rx="1" transform="rotate(315 32 32)"></rect>
    </g>
  </defs>
  <g transform="rotate(-45 32 32)" fill="var(--logo-wrench)" mask="url(#logo-jaws)">
    <rect x="2" y="29" width="60" height="6" rx="1.5"></rect>
    <circle cx="63" cy="32" r="7.2"></circle>
    <circle cx="1" cy="32" r="7.2"></circle>
  </g>
  <circle cx="32" cy="32" r="17" fill="var(--bg)"></circle>
  <use href="#logo-gear" clip-path="url(#logo-l)" fill="var(--logo-a)" stroke="var(--logo-a)"></use>
  <use href="#logo-gear" clip-path="url(#logo-r)" fill="var(--logo-b)" stroke="var(--logo-b)"></use>
  <g transform="translate(-1.3 0)">
    <path d="M24.4 43.2V27.4c0-5.1 2.9-7.9 7.6-7.9v3.8c-2.3 0-3.7 1.4-3.7 4.1v15.8z" fill="var(--logo-a)"></path>
    <circle cx="32.3" cy="21.9" r="2.3" fill="var(--logo-a)"></circle>
    <path d="M36.6 23.2l4.2-1.9v15.2c0 1.9.9 2.9 2.8 2.9h1.2v3.8h-1.7c-4.1 0-6.5-2.3-6.5-6.4z" fill="var(--logo-b)"></path>
    <rect x="20.8" y="27.4" width="24.2" height="3.8" rx="0.6" fill="var(--logo-a)"></rect>
  </g>
</svg>
