---
/** Brand mark: three tool "sliders" in a rounded tile. Works at favicon size. */
---
<svg viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="9" fill="var(--accent)"></rect>
  <rect x="7" y="8.5" width="18" height="3" rx="1.5" fill="var(--bg)"></rect>
  <rect x="7" y="14.5" width="12" height="3" rx="1.5" fill="var(--bg)"></rect>
  <rect x="7" y="20.5" width="15" height="3" rx="1.5" fill="var(--bg)"></rect>
  <circle cx="21.5" cy="16" r="3.2" fill="var(--bg)"></circle>
</svg>
