 * drawn in the accent color. Strokes use currentColor so it follows the theme.
 */
---
<svg viewBox="0 0 32 32" aria-hidden="true" class="logo-mark" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <path d="M10.5 27.5V11.5c0-4 2.3-6.2 6.2-6.2" stroke="currentColor" stroke-width="3.4"></path>
  <path d="M21 7.5v15c0 3.2 1.6 4.8 4.8 4.8" stroke="currentColor" stroke-width="3.4"></path>
