---
/** Small outline icons for tools. Add a case per new icon name in registry.ts. */
type Props = { name: string };
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'school' && (
    <>
      <path d="M22 9 12 5 2 9l10 4 10-4v6"></path>
      <path d="M6 10.6V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.4"></path>
    </>
  )}
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>}
</svg>
